<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hardened for a private app that talks to one office server only:
         - allowBackup off + data extraction rules: nothing is copied to Google Drive, another phone or by adb backup
         - cleartext (plain http) off: the office link is https only (and the Content-Security-Policy lists only that one address)
         - INTERNET and READ_CALL_LOG (call matching, opt-in) are the only permissions of our own: no storage, contacts or SMS access, and location only for the check-in (below). (The secure-storage plugin adds
           USE_BIOMETRIC and USE_FINGERPRINT, normal permissions that are never asked and not used.)
           The camera and gallery go through the system picker, so no CAMERA permission is needed either.
         Later: certificate pinning (network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Call matching (Calls tab): READ the call history so a call with a saved client number shows the client's name. Asked at run time,
         only after the person turns the feature on in the app. The app keeps only calls with saved client numbers. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Check-in (meeting) and client location: the phone's position is read ONCE when the rep taps the button, never in the background
         (no ACCESS_BACKGROUND_LOCATION). Asked at run time, after the app has explained why. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
